# Arbi.ai Environment Variables Example
# Copy this file to .env.local and fill in your actual values

# Gemini API Key for AI-powered arbitrage analysis
# Get your key from: https://makersuite.google.com/app/apikey
# WARNING: This should be moved to backend for production security
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# API Base URL for backend services
# Development: http://localhost:8000
# Production: https://api.arbi.creai.dev
VITE_API_BASE_URL=https://api.arbi.creai.dev

# Optional: Sentry DSN for error monitoring
# Get your DSN from: https://sentry.io/
VITE_SENTRY_DSN=your_sentry_dsn_here

# Optional: Environment identifier
NODE_ENV=development

# Optional: Enable/disable analytics
VITE_ENABLE_ANALYTICS=false

# Optional: App version (auto-populated in CI/CD)
VITE_APP_VERSION=0.0.0

# Note: VITE_ prefix is required for variables to be exposed to the client
# Security: Never commit .env.local or .env files with real credentials
# Best Practice: Move sensitive API keys (like GEMINI_API_KEY) to backend services
